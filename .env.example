GEMINI_API_KEY=your_gemini_api_key_here

# ---- More AI providers (all optional; free tiers). The app tries them in order and
# ---- moves to the next one when a provider is rate-limited, down, or out of quota.
# AI_PROVIDERS=gemini,groq,openrouter,cloudflare
# GROQ_API_KEY=                 # https://console.groq.com/keys
# OPENROUTER_API_KEY=           # https://openrouter.ai/keys (uses the free ":free" models)
# CLOUDFLARE_ACCOUNT_ID=        # https://dash.cloudflare.com → Workers AI (also free Flux images)
# CLOUDFLARE_API_TOKEN=
# Optional model overrides (otherwise picked automatically from each provider's model list):
# GROQ_MODEL=
# OPENROUTER_MODEL=
# CLOUDFLARE_MODEL=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ---- Use a PaperPilot AI server (our own; see /api/v1 and scripts/pp-keys.mjs)
# PAPERPILOT_AI_URL=https://your-server/api/v1
# PAPERPILOT_AI_KEY=pp_live_...

# ---- Your own GPU machine later (vLLM / Ollama / any OpenAI-compatible server)
# OPENAI_COMPAT_BASE_URL=http://your-gpu-box:8000/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# ---- Running as the PaperPilot AI server: where keys.json and usage logs live
# PAPERPILOT_SERVER_DIR=

# Optional: image + video generation without Gemini billing (https://enter.pollinations.ai/keys, use an sk_ key)
# POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_MODEL=
# POLLINATIONS_VIDEO_MODEL=alibaba/wan-2.2-fast
